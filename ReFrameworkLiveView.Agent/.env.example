# ─── Azure OpenAI ─────────────────────────────────────────────────────────────
# First slice: copy these from execution_agent/.env so chat works today.
# Later: run .\infra\deploy.ps1 for a dedicated Live View resource and replace.

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=

# ─── Sidecar ──────────────────────────────────────────────────────────────────
# 3002 so it does not collide with execution_agent on 3001.
API_PORT=3002
ALLOWED_ORIGINS=http://localhost:3000

# Game install. Heartbeat / req / res live under reframework/data/liveview_bridge.
GAME_DIR=D:\SteamLibrary\steamapps\common\OnimushaWotS
# LIVEVIEW_BRIDGE_DIR=D:\SteamLibrary\steamapps\common\OnimushaWotS\reframework\data\liveview_bridge
